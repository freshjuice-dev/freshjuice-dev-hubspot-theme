{
  "name": "freshjuice-dev-hubspot-theme",
  "version": "3.0.0",
  "description": "FreshJuice DEV is the open-source Community Edition of the FreshJuice theme — built for developers using HubSpot CMS, Tailwind CSS, Alpine.js, and more. Clean, fast, and flexible. The PRO version with additional modules and templates is available separately.",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf './_temp' './_dist' && mkdir './_temp' './_dist'",
    "fetch:hubspot": "hs fetch --overwrite /FreshJuice ./theme && ./scripts/post-fetch.sh",
    "upload:hubspot": "hs upload ./theme /FreshJuiceDEV",
    "watch:hubspot": "hs watch ./theme /FreshJuiceDEV",
    "watch:tailwind": "npx @tailwindcss/cli -i ./source/css/tailwind.css -o ./theme/css/tailwind.css --watch",
    "build:tailwind": "npx @tailwindcss/cli -i ./source/css/tailwind.css -o ./theme/css/tailwind.css",
    "watch:js": "npx esbuild ./source/js/main.js --outfile=./theme/js/main.js --bundle --watch",
    "build:js": "npx esbuild ./source/js/main.js --outfile=./theme/js/main.js --bundle",
    "build:zip": "./scripts/build-zip.sh",
    "version:patch": "./scripts/bump-theme-version.sh patch",
    "version:minor": "./scripts/bump-theme-version.sh minor",
    "version:major": "./scripts/bump-theme-version.sh major",
    "start": "run-p watch:*",
    "build": "run-s clean build:js build:tailwind build:zip",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/freshjuice-dev/freshjuice-dev-hubspot-theme.git"
  },
  "keywords": [
    "hubspot",
    "theme",
    "cms",
    "hubspot-cms",
    "alpinejs",
    "tailwindcss",
    "boilerplate"
  ],
  "author": {
    "name": "Alex Zappa",
    "email": "alex@zappa.dev",
    "url": "https://alex.zappa.dev/"
  },
  "contributors": [
    {
      "name": "Alex Zappa",
      "email": "alex@zappa.dev",
      "url": "https://alex.zappa.dev/"
    },
    {
      "name": "Aleksandr Zapparov",
      "email": "alexander@zapparov.dev",
      "url": "https://zapparov.dev/"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/freshjuice-dev/freshjuice-dev-hubspot-theme/issues"
  },
  "homepage": "https://github.com/freshjuice-dev/freshjuice-dev-hubspot-theme#readme",
  "devDependencies": {
    "@alpinejs/collapse": "^3.16.3",
    "@alpinejs/focus": "^3.16.3",
    "@alpinejs/intersect": "^3.16.3",
    "@tailwindcss/cli": "^4.3.3",
    "alpinejs": "^3.16.3",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "flying-pages-module": "^2.1.4",
    "husky": "^9.1.7",
    "lite-youtube-embed": "^0.3.4",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3",
    "tailwindcss-safe-area": "^1.3.0"
  }
}
